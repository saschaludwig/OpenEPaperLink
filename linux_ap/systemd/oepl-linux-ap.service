[Unit]
Description=OpenEPaperLink access point (Linux host for ESP32-C6 radio)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/OpenEPaperLink/linux_ap
Environment=OEPL_DATA_DIR=/var/lib/oepl
Environment=OEPL_SERIAL_AP_PORT=/dev/ttyS1
Environment=OEPL_SERIAL_DEBUG_PORT=/dev/ttyS2
Environment=OEPL_GPIO_CHIP=/dev/gpiochip0
Environment=OEPL_GPIO_RESET_LINE=203
Environment=OEPL_GPIO_BOOT_LINE=6
Environment=OEPL_HTTP_PORT=80
ExecStart=/opt/OpenEPaperLink/linux_ap/.venv/bin/python -m oepl_linux_ap
# /reboot and the nightly reboot exit the process; systemd brings it back.
Restart=always
RestartSec=3
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
